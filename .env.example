# Copy to .env for local use. Never commit actual credentials.
ENTSOE_API_TOKEN=your-token
MONGODB_URI=mongodb://localhost:27017
MONGODB_DATABASE=ind320
CASSANDRA_HOST=127.0.0.1
CASSANDRA_PORT=9042
CASSANDRA_KEYSPACE=ind320
# Leave both empty for local Cassandra without authentication.
CASSANDRA_USERNAME=
CASSANDRA_PASSWORD=
# Spark 3.5.1 uses Java 17. Set this to your own JDK directory.
JAVA_HOME=/path/to/jdk-17
